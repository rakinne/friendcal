// Copy to Local.xcconfig (gitignored). Team ID: Xcode > Settings > Apple Accounts.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Supabase project (Settings > API). In the URL write https:/$()/ so xcconfig does not read // as a comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY
